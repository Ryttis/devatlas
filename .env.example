# DevAtlas AI explanation adapter (OpenAI-compatible chat completions API).
# Copy to .env (ignored by Git) or to ~/.config/devatlas/.env.
# Leave everything empty to run without AI: rule results are still shown.
#
# API root that has /chat/completions below it.
DEVATLAS_AI_BASE_URL=
# Model name as the provider expects it.
DEVATLAS_AI_MODEL=
# Bearer token. Optional for local servers that need none.
DEVATLAS_AI_API_KEY=
